<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11(API 30)+는 패키지 가시성 제한 때문에 여기 선언 안 된 인텐트는 실제로 처리할 수
         있는 앱이 설치돼 있어도 PackageManager.queryIntentActivities()에 아예 안 보인다 - .hwp/.hwpx는
         표준 MIME이 없어 앱마다 등록값이 달라서(한글, 폴라리스오피스 등) 정확히 어떤 값인지 알 수
         없으므로, ACTION_VIEW + 모든 mimeType을 넓게 선언해서 "파일 열기" 관련 앱은 다 보이게 한다
         (사이드로드 전용 앱이라 스토어 정책상 문제 없음). 이게 없으면 FileSaver.openFile()의
         PackageManager 사전 확인이 실제로 앱이 있어도 항상 "없음"으로 잘못 판단한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 9(API 28) 이하에서 FileSaver가 공용 다운로드 폴더에 직접 쓰기 위해 필요.
         10 이상은 MediaStore.Downloads를 쓰므로 이 권한이 아예 필요/요청되지 않는다. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- UpdateBridge.downloadAndInstall()이 새 APK를 내려받아 바로 설치 화면을 띄우기 위해 필요.
         API 26+에서는 이 권한을 선언해도 자동으로 허용되는 게 아니라, 설치 시도 시 시스템이
         "이 출처의 앱 설치 허용" 설정 화면을 자동으로 띄워 사용자가 직접 허용해야 한다(1회성). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
